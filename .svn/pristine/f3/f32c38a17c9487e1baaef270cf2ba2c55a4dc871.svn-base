    public class ARInvoiceVATsController : BaseBusinessController
    {
        public ARInvoiceVATsController()
        {
            dal = new DALBaseProvider("ARInvoiceVATs", typeof(ARInvoiceVATsInfo));
        }
        public DataSet GetInvoiceVATListDatasetByListOfBranchID(
                                string invoiceNo,
                                DateTime? fromDate,
                                DateTime? toDate,
                                string vatDocumentNo,
                                string vatFormNo,
                                string inputDocumentType,
                                string vatSymbol,
                                List<BRBranchsInfo> branchList)
        {
            DataSet rtn = new DataSet();
            foreach (BRBranchsInfo ojbBranchsInfo in branchList)
            {
                DataSet ds = GetInvoiceVATListDataset(invoiceNo,
                                                    fromDate,
                                                    toDate,
                                                    vatDocumentNo,
                                                    vatFormNo,
                                                    inputDocumentType,
                                                    vatSymbol,
                                                    ojbBranchsInfo.BRBranchID);
                rtn.Merge(ds);
            }

            return rtn;
        }
        public DataSet GetInvoiceVATListDataset(
                                string invoiceNo,
                                DateTime? fromDate,
                                DateTime? toDate,
                                string vatDocumentNo,
                                string vatFormNo,
                                string inputDocumentType,
                                string vatSymbol,
                                int? branchID)
        {
            return dal.GetDataSet("ARInvoiceVATs_GetInvoiceVATListDataset",
                                invoiceNo,
                                fromDate,
                                toDate,
                                vatDocumentNo,
                                vatFormNo,
                                inputDocumentType,
                                vatSymbol,
                                branchID);
        }

  
    }
    #endregion
}