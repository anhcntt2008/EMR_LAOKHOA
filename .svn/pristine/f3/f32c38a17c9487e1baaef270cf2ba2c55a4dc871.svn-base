using System;
using System.Data;
using System.Text;
using System.Collections.Generic;
using BOSLib;


namespace BOSERP
{
    #region ARInvoiceVATs
    //-----------------------------------------------------------
    //Generated By: BOS Studio
    //Class:ARInvoiceVATsController
    //Created Date:Monday, August 11, 2014
