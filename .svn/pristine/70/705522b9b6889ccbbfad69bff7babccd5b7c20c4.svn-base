        public List<ARInvoicesInfo> GetInvoiceListFromDateToDate(int? branchId, DateTime fromDate, DateTime toDate, string createFrom = null, string createFromExclude = null)
        {
            var listInvoice = new List<ARInvoicesInfo>();
            var ds = dal.GetDataSet("Report_GetInvoiceListByBranchIDAndFromDateToDate", branchId, fromDate, toDate, createFrom, createFromExclude);
            var invoiceController = new ARInvoicesController();
            if (ds.Tables.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    ARInvoicesInfo invoice = (ARInvoicesInfo)invoiceController.GetObjectFromDataRow(row);
                    if (invoice.ARInvoiceCreateFrom == "BHYT" && invoice.ARInvoiceSubTotalAmount <= 195000)
                    {
                        invoice.ARInvoiceDueByPayer2 += invoice.ARInvoiceDueByPat;
                        invoice.ARInvoiceDueByPat = 0;
                    }
                    invoice.MEPatientNo = row["MEPatientNo"].ToString();
                    invoice.MEPatientNoStr = row["MEPatientNoStr"].ToString();
                    invoice.ARInvoiceNoStr = row["ARInvoiceNoStr"].ToString();
                    invoice.MEPatientName = row["MEPatientName"].ToString();
                    listInvoice.Add(invoice);
                }

            }
            return listInvoice;
        }
