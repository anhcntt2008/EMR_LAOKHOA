        /// <summary>
        /// Get income of customer by from date to date
        /// </summary>
        /// <param name="employeeID">Type of customer</param>
        /// <param name="fromDate">Search from date</param>
        /// <param name="toDate">Search to date</param>
        /// <returns>Income of customer list</returns>
        public List<ARCustomersInfo> GetIncomeOfCustomerByFromDateToDate(string customerType, DateTime? fromDate, DateTime? toDate, int customerID)
        {
            DataSet ds = dal.GetDataSet("Report_GetIncomeOfCustomerList", customerType, fromDate, toDate, customerID);
            if (ds.Tables[0].Rows.Count > 0)
            {
                ARCustomersController objCustomersController = new ARCustomersController();
                List<ARCustomersInfo> customerList = new List<ARCustomersInfo>();
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    ARCustomersInfo objCustomersInfo = (ARCustomersInfo)objCustomersController.GetObjectFromDataRow(row);
                    if (objCustomersInfo != null)
                    {
                        if (objCustomersInfo.ARCustomerTypeCombo != CustomerType.Patient.ToString())
                            objCustomersInfo.MEPatienVisitTotalQty = objCustomersInfo.MECompanyVisitTotalQty;
                        customerList.Add(objCustomersInfo);
                    }
                }
                return customerList;
            }
            return null;
        }

