        /// <summary>
        /// Get income of employee by from date to date (from visit)
        /// </summary>
        /// <param name="employeeType"></param>
        /// <param name="fromDate"></param>
        /// <param name="toDate"></param>
        /// <returns></returns>
        public List<MEVisitOrderItemsInfo> GetIncomeOfEmployeeByFromDateToDate_FromVisit(int? employeeID, DateTime? fromDate, DateTime? toDate)
        {
            DataSet ds = dal.GetDataSet("Report_GetIncomeOfEmployeeList_FromVisit", employeeID, fromDate, toDate);
            if (ds.Tables[0].Rows.Count > 0)
            {
                MEVisitOrderItemsController objVisitOrderItemsController = new MEVisitOrderItemsController();
                List<MEVisitOrderItemsInfo> visitOrderItemList = new List<MEVisitOrderItemsInfo>();
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    MEVisitOrderItemsInfo objVisitOrderItemsInfo = (MEVisitOrderItemsInfo)objVisitOrderItemsController.GetObjectFromDataRow(row);
                    if (objVisitOrderItemsInfo != null)
                        visitOrderItemList.Add(objVisitOrderItemsInfo);
                }
                return visitOrderItemList;
            }
            return null;
        }



