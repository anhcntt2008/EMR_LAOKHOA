        /// <param name="fromDate">From date</param>
        /// <param name="toDate">To date</param>
        /// <returns></returns>
        public DataSet GetInvoiceListByBranchIDAndFromDateToDate(int? branchID, DateTime fromDate, DateTime toDate, string createFrom = null, string createFromExclude = null)
