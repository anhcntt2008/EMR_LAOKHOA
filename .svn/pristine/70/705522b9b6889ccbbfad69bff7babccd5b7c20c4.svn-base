        public List<MEPatientVisitsInfo> RPMauso79aBHYT(int? patientVisitID, DateTime? fromDate, DateTime? toDate)
        {
            DataSet ds = dal.GetDataSet("Report_Mauso79aBHYT", patientVisitID, fromDate, toDate);
            MEPatientVisitsController patientController = new MEPatientVisitsController();
            List<MEPatientVisitsInfo> result = new List<MEPatientVisitsInfo>();
            if (ds != null && ds.Tables.Count != 0)
            {
                int idx = 1;

                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    MEPatientVisitsInfo patientVisit = patientController.GetObjectFromDataRow(row) as MEPatientVisitsInfo;
                    //Some const
                    patientVisit.STT = idx;
                    if (toDate != null)
                    {
                        patientVisit.nam_qt = toDate.Value.Year.ToString();
                        patientVisit.thang_qt = Convert.ToString(toDate.Value.Month + 1);
                    }
                    else
                    {
                        patientVisit.nam_qt = DateTime.Now.Year.ToString();
                        patientVisit.thang_qt = Convert.ToString(DateTime.Now.Month);
                    }

                    patientVisit.tinh_trang_rv = "1";
                    patientVisit.ket_qua_dtri = "2";
                    patientVisit.ma_lydo_vvien = "1";
                    //patientVisit.ma_cskcb = "79513";
                    patientVisit.ma_benhkhac = "";
                    if (patientVisit.MEPatientVisitICD10No1 != null & patientVisit.MEPatientVisitICD10No1 != "")
                    {
                        patientVisit.ma_benhkhac = patientVisit.MEPatientVisitICD10No1;
                    }
                    if (patientVisit.MEPatientVisitICD10No2 != null & patientVisit.MEPatientVisitICD10No2 != "")
                    {
                        patientVisit.ma_benhkhac = patientVisit.ma_benhkhac + ";" + patientVisit.MEPatientVisitICD10No2;
                    }
                    if (patientVisit.MEPatientVisitICD10No3 != null & patientVisit.MEPatientVisitICD10No3 != "")
                    {
                        patientVisit.ma_benhkhac = patientVisit.ma_benhkhac + ";" + patientVisit.MEPatientVisitICD10No3;
                    }

                    patientVisit.ma_khuvuc = "79";
                    patientVisit.t_vtyt_tyle = 0;
                    patientVisit.TransportationFeeAmount = 0;
                    patientVisit.t_giuong = 0;
                    patientVisit.t_ngoaids = 0;
                    patientVisit.so_ngay_dtri = 1;
                    patientVisit.ma_loaikcb = "2";

                    //Change gender format
                    if (patientVisit.MEGender == "Male")
                    {
                        patientVisit.MEGender = "1";
                        //Change date format
                        patientVisit.MEPatientBirthday2 = patientVisit.MEPatientBirthday.Year.ToString("0000"); // + patientVisit.MEPatientBirthday.Month.ToString("00") + patientVisit.MEPatientBirthday.Day.ToString("00");
                    }
                    else
                    {
                        patientVisit.MEGender = "2";
                        //Change date format
                        patientVisit.MEPatientBirthday3 = patientVisit.MEPatientBirthday.Year.ToString("0000"); // + patientVisit.MEPatientBirthday.Month.ToString("00") + patientVisit.MEPatientBirthday.Day.ToString("00");
                    }

                    patientVisit.MEPatientInsRegisteredDate2 = patientVisit.MEPatientInsRegisteredDate.Year.ToString("0000") + patientVisit.MEPatientInsRegisteredDate.Month.ToString("00") + patientVisit.MEPatientInsRegisteredDate.Day.ToString("00");
                    patientVisit.MEPatientInsExpiryDate2 = patientVisit.MEPatientInsExpiryDate.Year.ToString("0000") + patientVisit.MEPatientInsExpiryDate.Month.ToString("00") + patientVisit.MEPatientInsExpiryDate.Day.ToString("00");

                    patientVisit.ARInvoiceDate2 = patientVisit.ARInvoiceDate.Day.ToString("00") + "/" + patientVisit.ARInvoiceDate.Month.ToString("00") + "/" + patientVisit.ARInvoiceDate.Year.ToString("0000")
                                                    + patientVisit.ARInvoiceDate.Hour.ToString("00") + patientVisit.ARInvoiceDate.Minute.ToString("00");
                    patientVisit.ARInvoiceDate3 = patientVisit.ARInvoiceDate.Year.ToString("0000") + patientVisit.ARInvoiceDate.Month.ToString("00") + patientVisit.ARInvoiceDate.Day.ToString("00")
                                                    + (patientVisit.ARInvoiceDate.Hour + 1).ToString("00") + patientVisit.ARInvoiceDate.Minute.ToString("00");

                    if (patientVisit.MEPatientInsRegisteredPlaceNo != null)
                    {
                        patientVisit.MEPatientInsRegisteredPlaceNo = patientVisit.MEPatientInsRegisteredPlaceNo.Replace("-", "");
                    }

                    //Calculate insurance amount
                    double labAmount = patientVisit.LabAmount;
                    double imagingAmount = patientVisit.ImagingAmount;
                    double drugsAmount = patientVisit.DrugsAmount;
                    double bloodAndBloodProductsAmount = patientVisit.BloodAndBloodProductsAmount;
                    double tipsAmount = patientVisit.TipsAmount;
                    double equipmentAmount = patientVisit.EquipmentAmount;
                    double highTechServicesAmount = patientVisit.HighTechServicesAmount;
                    double drugsKAmount = patientVisit.DrugsKAmount;
                    double examinationFeeAmount = patientVisit.ExaminationFeeAmount;
                    double transportationFeeAmount = patientVisit.TransportationFeeAmount;
                    double othersAmount = patientVisit.OthersAmount;
                    double surgeryAmount = patientVisit.SurgeryAmount;
                    double explorationOfTheFunction = patientVisit.ExplorationOfTheFunctionAmount;

                    patientVisit.ARInvoiceItemPayer2Amount = labAmount +
                                                             imagingAmount +
                                                             drugsAmount +
                                                             bloodAndBloodProductsAmount +
                                                             tipsAmount +
                                                             equipmentAmount +
                                                             highTechServicesAmount +
                                                             drugsKAmount +
                                                             examinationFeeAmount +
                                                             transportationFeeAmount +
                                                             surgeryAmount +
                                                             explorationOfTheFunction +
                                                             othersAmount;

                    if (patientVisit.ARInvoiceItemInsDeductRate > 0)
                    {
                        patientVisit.LabAmount = labAmount * 100 / patientVisit.ARInvoiceItemInsDeductRate;
                        patientVisit.ImagingAmount = imagingAmount * 100 / patientVisit.ARInvoiceItemInsDeductRate;
                        patientVisit.DrugsAmount = drugsAmount * 100 / patientVisit.ARInvoiceItemInsDeductRate;
                        patientVisit.BloodAndBloodProductsAmount = bloodAndBloodProductsAmount * 100 / patientVisit.ARInvoiceItemInsDeductRate;
                        patientVisit.TipsAmount = tipsAmount * 100 / patientVisit.ARInvoiceItemInsDeductRate;
                        patientVisit.EquipmentAmount = equipmentAmount * 100 / patientVisit.ARInvoiceItemInsDeductRate;
                        patientVisit.HighTechServicesAmount = highTechServicesAmount * 100 / patientVisit.ARInvoiceItemInsDeductRate;
                        patientVisit.DrugsKAmount = drugsKAmount * 100 / patientVisit.ARInvoiceItemInsDeductRate;
                        patientVisit.ExaminationFeeAmount = examinationFeeAmount * 100 / patientVisit.ARInvoiceItemInsDeductRate;
                        patientVisit.TransportationFeeAmount = transportationFeeAmount * 100 / patientVisit.ARInvoiceItemInsDeductRate;
                        patientVisit.OthersAmount = othersAmount * 100 / patientVisit.ARInvoiceItemInsDeductRate;
                        patientVisit.SurgeryAmount = surgeryAmount * 100 / patientVisit.ARInvoiceItemInsDeductRate;
                        patientVisit.ExplorationOfTheFunctionAmount =
                            explorationOfTheFunction * 100 / patientVisit.ARInvoiceItemInsDeductRate;
                        patientVisit.LabAmountByPat = patientVisit.LabAmount - labAmount;
                        patientVisit.ImagingAmountByPat = patientVisit.ImagingAmount - imagingAmount;
                        patientVisit.DrugsAmountByPat = patientVisit.DrugsAmount - drugsAmount;
                        patientVisit.BloodAndBloodProductsAmountByPat =
                            patientVisit.BloodAndBloodProductsAmount - bloodAndBloodProductsAmount;
                        patientVisit.TipsAmountByPat = patientVisit.TipsAmount - tipsAmount;
                        patientVisit.EquipmentAmountByPat = patientVisit.EquipmentAmount - equipmentAmount;
                        patientVisit.HighTechServicesAmountByPat =
                            patientVisit.HighTechServicesAmount - highTechServicesAmount;
                        patientVisit.DrugsKAmountByPat = patientVisit.DrugsKAmount - drugsKAmount;
                        patientVisit.ExaminationFeeAmountByPat =
                            patientVisit.ExaminationFeeAmount - examinationFeeAmount;
                        patientVisit.TransportationFeeAmountByPat =
                            patientVisit.TransportationFeeAmount - transportationFeeAmount;
                        patientVisit.SurgeryAmountByPat = patientVisit.SurgeryAmount - surgeryAmount;
                        patientVisit.ExplorationOfTheFunctionAmountByPat =
                            patientVisit.ExplorationOfTheFunctionAmount - explorationOfTheFunction;
                    }
                    patientVisit.ARInvoiceItemTotalAmount = patientVisit.LabAmount +
                                                            patientVisit.ImagingAmount +
                                                            patientVisit.DrugsAmount +
                                                            patientVisit.BloodAndBloodProductsAmount +
                                                            patientVisit.TipsAmount +
                                                            patientVisit.EquipmentAmount +
                                                            patientVisit.HighTechServicesAmount +
                                                            patientVisit.DrugsKAmount +
                                                            patientVisit.ExaminationFeeAmount +
                                                            patientVisit.TransportationFeeAmount +
                                                            patientVisit.SurgeryAmount +
                                                            patientVisit.ExplorationOfTheFunctionAmount +
                                                            patientVisit.OthersAmount;

                    patientVisit.ARInvoiceItemPatientAmount = (patientVisit.LabAmount - labAmount) +
                                                              (patientVisit.ImagingAmount - imagingAmount) +
                                                              (patientVisit.DrugsAmount - drugsAmount) +
                                                              (patientVisit.BloodAndBloodProductsAmount - bloodAndBloodProductsAmount) +
                                                              (patientVisit.TipsAmount - tipsAmount) +
                                                              (patientVisit.EquipmentAmount - equipmentAmount) +
                                                              (patientVisit.HighTechServicesAmount - highTechServicesAmount) +
                                                              (patientVisit.DrugsKAmount - drugsKAmount) +
                                                              (patientVisit.ExaminationFeeAmount - examinationFeeAmount) +
                                                              (patientVisit.TransportationFeeAmount - transportationFeeAmount) +
                                                              (patientVisit.SurgeryAmount - surgeryAmount) +
                                                              (patientVisit.ExplorationOfTheFunctionAmount - explorationOfTheFunction) +
                                                              (patientVisit.OthersAmount - othersAmount);

                    result.Add(patientVisit);

                    idx++;
                }
            }
            return result;
        }

    }
    #endregion
}