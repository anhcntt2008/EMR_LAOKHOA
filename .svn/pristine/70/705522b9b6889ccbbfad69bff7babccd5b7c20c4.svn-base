            List<ARInvoicesInfo> invoices = new List<ARInvoicesInfo>();
            ARInvoicesController objInvoicesController = new ARInvoicesController();
            DataSet ds = dal.GetDataSet("Report_GetInvoicesBySomeCriteriaForRP132", branchID, customerID, invoiceType, invoiceDateFrom, invoiceDateTo, employeeID, invoiceStatusCTRL);
            if (ds.Tables.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    ARInvoicesInfo objInvoicesInfo = (ARInvoicesInfo)objInvoicesController.GetObjectFromDataRow(row);
                    invoices.Add(objInvoicesInfo);
                }
            }
            return invoices;
        }
        public List<MEVisitOrderItemsInfo> Report_GetPhysicianOrderByVisitOrderID(int visitOrderID)
        {
            List<MEVisitOrderItemsInfo> result = new List<MEVisitOrderItemsInfo>();
            MEVisitOrderItemsController orderItemController = new MEVisitOrderItemsController();
            DataSet ds = dal.GetDataSet("Report_GetPhysicianOrderByVisitOrderID", visitOrderID);
            if (ds != null && ds.Tables.Count != 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    MEVisitOrderItemsInfo orderItem = orderItemController.GetObjectFromDataRow(row) as MEVisitOrderItemsInfo;
                    if (orderItem != null && orderItem.ICProductSubType != ProductSubType.ExaminationFee)
                        result.Add(orderItem);
                }
            }

            return result;
        }

        public List<ARProspectCustomersInfo> GetProspectCustomerListBySomeCriterias(string status, string type)
        {
            DataSet ds = dal.GetDataSet("Report_GetProspectCustomerListBySomeCriterias", status, type);
