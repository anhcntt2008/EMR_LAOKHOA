    public class HRDepartmentsController : BaseBusinessController
    {
        public HRDepartmentsController()
        {
            dal = new DALBaseProvider("HRDepartments", typeof(HRDepartmentsInfo));
        }

        public List<HRDepartmentsInfo> GetAllList()
        {
            DataSet ds = dal.GetDataSet("HRDepartments_SelectAll");
            List<HRDepartmentsInfo> level = new List<HRDepartmentsInfo>();
            if (ds.Tables.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    HRDepartmentsInfo objLevelsInfo = (HRDepartmentsInfo)GetObjectFromDataRow(row);
                    level.Add(objLevelsInfo);
                }
            }
            return level;
        }

        public List<HRDepartmentsInfo> GetAllDeptsOfEmp(int empId, int currentDeptId)
        {
            var ds = dal.GetDataSet("HREmpWorkingDepts_GetAllDeptsOfEmp", empId, currentDeptId);
            return GetListBusinessObjects<HRDepartmentsInfo>(ds);
        }

        public DataSet GetDepartmentsForLookupEdit()
        {
            return dal.GetDataSet("HRDepartments_GetDepartmentsForLookupEdit");
        }
    }
    #endregion
}