                _bRBranchHealthInsuranceProviceCode = value;
                NotifyChanged("BRBranchHealthInsuranceProviceCode");
            }
        }

        public string BRBranchHealthInsuranceUserName
        {
            get { return _bRBranchHealthInsuranceUserName; }
            set
            {
                if (value == _bRBranchHealthInsuranceUserName)
                    return;
                _bRBranchHealthInsuranceUserName = value;
                NotifyChanged("BRBranchHealthInsuranceUserName");
            }
        }

        public string BRBranchHealthInsurancePassword
        {
            get { return _bRBranchHealthInsurancePassword; }
            set
            {
                if (value == _bRBranchHealthInsurancePassword)
                    return;
                _bRBranchHealthInsurancePassword = value;
                if (!string.IsNullOrEmpty(_bRBranchHealthInsurancePassword))
                    PasswordEncode = _cryp.Decrypt(_bRBranchHealthInsurancePassword);
                NotifyChanged("BRBranchHealthInsurancePassword");
            }
        }

        public string PasswordEncode
        {
            get { return _passwordEncode; }
            set
            {
                if (value == _passwordEncode)
                    return;

                _passwordEncode = value;
                var encryptValue = string.IsNullOrEmpty(value) ? string.Empty : _cryp.Encrypt(value);
                _bRBranchHealthInsurancePassword = encryptValue;
                NotifyChanged("PasswordEncode");
            }
        }

        public int BRBranchInvoiceInsuranceNo
        {
            get { return _bRBranchInvoiceInsuranceNo; }
            set
            {
                if (value == _bRBranchInvoiceInsuranceNo)
                    return;
                _bRBranchInvoiceInsuranceNo = value;
                NotifyChanged("BRBranchInvoiceInsuranceNo");
            }
        }

