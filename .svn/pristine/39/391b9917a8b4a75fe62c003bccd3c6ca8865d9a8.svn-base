using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace BOSLib
{
    public class SignerNameDto
    {
        public SignerNameDto(string relation, string fullName, string signerNo)
        {
            Relation = relation;
            FullName = fullName;
            SignerNo = signerNo;
        }

        public string SignerNo { get; set; }
        public string Relation { get; set; }
        public string FullName { get; set; }
    }
}
