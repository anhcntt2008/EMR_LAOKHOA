using System;
using System.Data;
using System.Text;
using System.Collections.Generic;
using BOSLib;


namespace BOSERP
{
    #region ACAssetReceipts
    //-----------------------------------------------------------
    //Generated By: BOS Studio
    //Class:ACAssetReceiptsController
