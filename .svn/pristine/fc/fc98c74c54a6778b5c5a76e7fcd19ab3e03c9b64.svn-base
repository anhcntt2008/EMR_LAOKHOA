    public class MELabParamsController : BaseBusinessController
    {
        public MELabParamsController()
        {
            dal = new DALBaseProvider("MELabParams", typeof(MELabParamsInfo));
        }

        /// <summary>
        /// Get a lab param by lab id and param name
        /// </summary>
        /// <param name="labID">Lab id</param>
        /// <param name="paramName">Param name</param>
        /// <returns>Lab param object</returns>
        public MELabParamsInfo GetLabParamByLabIDAndParamName(int labID, string paramName)
        {
            DataSet ds = dal.GetDataSet("MELabParams_GetLabParamByLabIDAndParamName", labID, paramName);
            if (ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                MELabParamsInfo objLabParamsInfo = (MELabParamsInfo)GetObjectFromDataRow(ds.Tables[0].Rows[0]);
                return objLabParamsInfo;
            }
            return null;

        }

        /// <summary>
        /// Get Lab Params list by lab id
        /// </summary>
        /// <param name="labID">Lab id</param>
        /// <returns>List of lab params</returns>
        public DataSet GetLabParamListByLabID(int labID)
        {
            return dal.GetDataSet("MELabParams_GetLabParamListByLabID", labID);
        }

        public List<MELabParamsInfo> GetLabParamByLabType(string labName)
        {
            DataSet ds = dal.GetDataSet("MELabParams_GetLabParamByLabType", labName);
            List<MELabParamsInfo> list = new List<MELabParamsInfo>();
            MELabParamsInfo objLabParamsInfo;
            if (ds.Tables.Count > 0)
            {
                for (int i = 0; i < ds.Tables[0].Rows.Count; i++)
                {
                    objLabParamsInfo = (MELabParamsInfo)GetObjectFromDataRow(ds.Tables[0].Rows[i]);
                    list.Add(objLabParamsInfo);
                }
            }
            return list;
        }
    }
