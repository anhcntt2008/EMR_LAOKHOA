    public class MEEmrActionRelationsController : BaseBusinessController
    {
        public MEEmrActionRelationsController()
        {
            dal = new DALBaseProvider("MEEmrActionRelations", typeof(MEEmrActionRelationsInfo));
        }
        public List<MEEmrActionRelationsInfo> GetAllByParentID(int parentID)
        {
            var ds = dal.GetAllDataByForeignColumn("FK_MEEmrActionParentID", parentID);
            var businessObjectList = new List<MEEmrActionRelationsInfo>();
            if (ds.Tables.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    var objBusinessObject = (MEEmrActionRelationsInfo)SqlDatabaseHelper.GetObjectFromDataRow(row, dal.ObjectType);
                    businessObjectList.Add(objBusinessObject);
                }
            }
            return businessObjectList;
        }
        public List<MEEmrActionRelationsInfo> GetTree(List<MEEmrActionRelationsInfo> list, int parent)
        {
            return list.Where(x => x.FK_MEEmrActionDependOnID == parent).Select(x =>
            {
                x.Children = x.FK_MEEmrActionDependOnID != x.FK_MEEmrActionChildID ? GetTree(list, x.FK_MEEmrActionChildID) : new List<MEEmrActionRelationsInfo>();
                x.Children = x.Children.OrderBy(o => o.MEEmrActionRelationOrder).ToList();
                return x;
            }).ToList();
        }
    }
    #endregion
}