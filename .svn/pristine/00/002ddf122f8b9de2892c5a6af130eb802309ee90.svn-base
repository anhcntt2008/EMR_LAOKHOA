    public class METimeFramesController : BaseBusinessController
    {
        public METimeFramesController()
        {
            dal = new DALBaseProvider("METimeFrames", typeof(METimeFramesInfo));
        }

        public List<METimeFramesInfo> GetListAllTimeFrames()
        {
            DataSet ds = dal.GetAllObject();
            List<METimeFramesInfo> listTimeFrames = new List<METimeFramesInfo>();
            if(ds.Tables.Count > 0)
            {
                for (int i = 0; i < ds.Tables[0].Rows.Count; i++)
                {
                    METimeFramesInfo objTimeFramesInfo = (METimeFramesInfo)GetObjectFromDataRow(ds.Tables[0].Rows[i]);
                    listTimeFrames.Add(objTimeFramesInfo);
                }
            }
            return listTimeFrames;
        }
    }
    #endregion
}