CREATE OR ALTER PROCEDURE [dbo].[MEEmrTypeTemplates_GetObjectByTypeAndTemplate]
	@FK_MEEmrTypeID int,
	@FK_METemplateID int
AS
BEGIN
SET NOCOUNT ON
SELECT TOP 1 * FROM [dbo].[MEEmrTypeTemplates]
WHERE [AAStatus]='Alive'
	AND [FK_MEEmrTypeID]=@FK_MEEmrTypeID
	AND [FK_METemplateID]=@FK_METemplateID
END
