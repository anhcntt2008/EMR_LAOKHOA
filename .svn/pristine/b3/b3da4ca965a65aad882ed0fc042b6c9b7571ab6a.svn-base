    public class APFeePaymentReceiptsController : BaseBusinessController
    {
        public APFeePaymentReceiptsController()
        {
            dal = new DALBaseProvider("APFeePaymentReceipts", typeof(APFeePaymentReceiptsInfo));
        }


        /// <summary>
        /// Get the list of receipts whose fee is paid by a payment
        /// </summary>
        /// <param name="feePaymentID">Fee payment id</param>
        /// <returns>List of receipts</returns>
        public List<APFeePaymentReceiptsInfo> GetReceiptsByFeePaymentID(int feePaymentID)
        {
            DataSet ds = dal.GetDataSet("APFeePaymentReceipts_GetReceiptsByFeePaymentID", feePaymentID);
            return (List<APFeePaymentReceiptsInfo>)GetListFromDataSet(ds);
        }

        public override System.Collections.IList GetListFromDataSet(DataSet ds)
        {
            List<APFeePaymentReceiptsInfo> receipts = new List<APFeePaymentReceiptsInfo>();
            if (ds.Tables.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    APFeePaymentReceiptsInfo objFeePaymentReceiptsInfo = (APFeePaymentReceiptsInfo)GetObjectFromDataRow(row);
                    receipts.Add(objFeePaymentReceiptsInfo);
                }
            }
            return receipts;
        }
    }
    #endregion
