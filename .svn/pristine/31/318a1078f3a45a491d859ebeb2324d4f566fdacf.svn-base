    public class ARProspectCustomersController : BaseBusinessController
    {
        public ARProspectCustomersController()
        {
            dal = new DALBaseProvider("ARProspectCustomers", typeof(ARProspectCustomersInfo));
        }

        public DataSet GetProspectCustomerSet(
            string ARProspectCustomerName,
            string ARProspectCustomerStatus,
            string ARProspectCustomerIDCard,
            string ARProspectCustomerTel,
            string ARProspectCustomerEmail,
            string ARProspectCustomerGender,
            string ARProspectCustomerReferNo,
            string ARProspectCustomerAddress,
            string ARProspectCustomerProductProspect,
            DateTime from, DateTime to
            )
        {
            DataSet ds = dal.GetDataSet("ARProspectCustomers_GetProspectCustomerSet",
                                        ARProspectCustomerName,
                                        ARProspectCustomerStatus,
                                        ARProspectCustomerIDCard,
                                        ARProspectCustomerTel,
                                        ARProspectCustomerEmail,
                                        ARProspectCustomerGender,
                                        ARProspectCustomerReferNo,
                                        ARProspectCustomerAddress,
                                        ARProspectCustomerProductProspect, from, to);
            return ds;
        }
        public DataSet GetProspectCustomerList(
                                            string ARProspectCustomerName,
                                            string ARProspectCustomerStatus,
                                            string ARProspectCustomerIDCard,
                                            string ARProspectCustomerTel,
                                            string ARProspectCustomerEmail,
                                            string ARProspectCustomerGender,
                                            string ARProspectCustomerReferNo,
                                            string ARProspectCustomerAddress,
                                            string ARProspectCustomerProductProspect,
                                            DateTime from, DateTime to,
                                            int? employeeID,         
                                            int? brandID
                                             )
        {
            DataSet ds = dal.GetDataSet("ARProspectCustomers_GetProspectCustomerList",
                                        ARProspectCustomerName,
                                        ARProspectCustomerStatus,
                                        ARProspectCustomerIDCard,
                                        ARProspectCustomerTel,
                                        ARProspectCustomerEmail,
                                        ARProspectCustomerGender,
                                        ARProspectCustomerReferNo,
                                        ARProspectCustomerAddress,
                                        ARProspectCustomerProductProspect, from, to,employeeID, brandID );
            return ds;
        }
        public DataSet GetProspectCustomerListByListOfBranchID(
                                                            
                                                            string ARProspectCustomerName,
                                                            string ARProspectCustomerStatus,
                                                            string ARProspectCustomerIDCard,
                                                            string ARProspectCustomerTel,
                                                            string ARProspectCustomerEmail,
                                                            string ARProspectCustomerGender,
                                                            string ARProspectCustomerReferNo,
                                                            string ARProspectCustomerAddress,
                                                            string ARProspectCustomerProductProspect,
                                                            DateTime from, DateTime to,
                                                            int? employeeID,
                                                            List<BRBranchsInfo> branchList)
        {
            DataSet rtn = new DataSet();
            foreach (BRBranchsInfo ojbBranchsInfo in branchList)
            {
                DataSet ds = GetProspectCustomerList(ARProspectCustomerName,
                                                        ARProspectCustomerStatus,
                                                        ARProspectCustomerIDCard,
                                                        ARProspectCustomerTel,
                                                        ARProspectCustomerEmail,
                                                        ARProspectCustomerGender,
                                                        ARProspectCustomerReferNo,
                                                        ARProspectCustomerAddress,
                                                        ARProspectCustomerProductProspect,
                                                        from, to, employeeID, ojbBranchsInfo.BRBranchID);
                rtn.Merge(ds);
            }

            return rtn;
        }
    }
    #endregion
}