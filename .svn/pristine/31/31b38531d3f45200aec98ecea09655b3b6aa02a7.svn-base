        public List<ARDocumentPaymentsInfo> GetDocumentPaymentsByCustomerID(int customerID, int saleOrderID)
        {
            DataSet ds = dal.GetDataSet("ARDocumentPayments_GetDocumentPaymentsByCustomerID", customerID, saleOrderID);
