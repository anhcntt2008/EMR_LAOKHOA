        public override string GenerateSearchQuery(string strTableName)
        {
            string query = base.GenerateSearchQuery(strTableName);
            query += string.Format(" and (ICProductType = '{0}' or ICProductType = '{1}')",
                                          ProductType.Medicine.ToString(), ProductType.Equipment.ToString());
            return query;            
        }

        public void DeleteItemFromMedicineComponentList()
        {
            ICProductEntities entity = (ICProductEntities)CurrentModuleEntity;
            entity.MEMedicineComponentList.RemoveSelectedRowObjectFromList();
        }

        public void DeleteItemFromProductAccountList()
        {
            ICProductEntities entity = (ICProductEntities)CurrentModuleEntity;
            entity.ICProductAccountList.RemoveSelectedRowObjectFromList();
        }


        #region Units of Measure
        /// <summary>
        /// Show form measure of units.
        /// </summary>
        public void ShowMeasureOfUnits()
        {
            ICProductEntities entity = (ICProductEntities)CurrentModuleEntity;
            ICProductsInfo objICProductsInfo = (ICProductsInfo)entity.MainObject;
            if (objICProductsInfo.FK_ICProductBasicUnitID > 0)
            {
                guiMeasureUnit guiMeasureUnit = new guiMeasureUnit(null,entity.ICProductUnitsList);
                guiMeasureUnit.Module = this;
                guiMeasureUnit.ShowDialog();
            }
        }

        /// <summary>
        /// Called when user change the basic unit
        /// </summary>
        public void ChangeBasicUnit(int basicUnitID)
        {
            ICProductEntities entity = (ICProductEntities)CurrentModuleEntity;
            ICProductsInfo objProductsInfo = (ICProductsInfo)entity.MainObject;
            //Clear all existing units as they depends on the basic unit
            entity.ICProductUnitsList.Clear();
            //Add new basic unit to product unit list
            ICProductUnitsInfo objProductUnitsInfo = new ICProductUnitsInfo();
            objProductUnitsInfo.FK_ICMeasureUnitID = basicUnitID;
            objProductUnitsInfo.FK_ICProductID = objProductsInfo.ICProductID;
            objProductUnitsInfo.ICProductUnitFactor = 1;
            objProductUnitsInfo.ICProductUnitPrice = objProductsInfo.ICProductPrice01;
            objProductUnitsInfo.ICProductUnitIsBasic = true;
            objProductUnitsInfo.ICProductUnitBarCode = objProductsInfo.ICProductBarCode;
            entity.ICProductUnitsList.Add(objProductUnitsInfo);

        }
        #endregion

        public override void ActionNew()
        {
            base.ActionNew();
            BOSRadioGroup meDeRadioGroup = (BOSRadioGroup)Controls[ICProductModule.MedicineDeviceRadioGroupName];
            meDeRadioGroup.EditValue = BOSCommon.Department.Medicine;
            meDeRadioGroup.SelectedIndex = 0;
        }

        public override void Invalidate(int iObjectID)
        {
            base.Invalidate(iObjectID);

            InvalidateScreen();
        }

        /// <summary>
        /// Invalidate screen when user choose medicine or device in radio group box or invalidate product
        /// </summary>
        public void InvalidateScreen()
        {
            ICProductEntities entity = (ICProductEntities)CurrentModuleEntity;
            BOSRadioGroup meDeRadioGroup = (BOSRadioGroup)Controls[ICProductModule.MedicineDeviceRadioGroupName];
            BOSGroupControl medicineGroupControl = (BOSGroupControl)Controls[ICProductModule.MedicineInfoGroupControlName];
            BOSGroupControl deviceGroupControl = (BOSGroupControl)Controls[ICProductModule.DeviceInfoGroupControlName];
            BOSGroupControl medicineListGroupControl = (BOSGroupControl)Controls[ICProductModule.MedicineListGroupControlName];
            BOSLookupEdit modelLookupEdit = (BOSLookupEdit)Controls[ICProductModule.ModelAttributeValueLookupEditName];
            BOSLookupEdit sizeLookupEdit = (BOSLookupEdit)Controls[ICProductModule.SizeAttributeValueLookupEditName];
            // Medicine screen
            if (Convert.ToInt32(meDeRadioGroup.EditValue) == BOSCommon.Department.Medicine)
            {
                medicineGroupControl.Visible = true;
                medicineListGroupControl.Visible = false;
                deviceGroupControl.Visible = false;
                meDeRadioGroup.SelectedIndex = 0;
            }
            // Device screen
            else
            {                
                medicineGroupControl.Visible = false;
                medicineListGroupControl.Visible = false;
                deviceGroupControl.Location = new System.Drawing.Point(medicineGroupControl.Location.X,
                                                                            medicineGroupControl.Location.Y);
                deviceGroupControl.Visible = true;
                // Set value for model and size attribute lookup edit
                ICProductsInfo objProductsInfo = (ICProductsInfo)entity.MainObject;

                string[] attribute = objProductsInfo.ICProductAttributeKey.Split('_');
                modelLookupEdit.EditValue = !string.IsNullOrEmpty(attribute[0])
                                                                        ? Convert.ToInt32(attribute[0]) : 0;
                sizeLookupEdit.EditValue = !string.IsNullOrEmpty(attribute[0])
                                                                        ? Convert.ToInt32(attribute[1]) : 0;
                meDeRadioGroup.SelectedIndex = 1;

                ((BOSERPScreen)ActiveScreen).AddExtraControls(deviceGroupControl.Controls);
            }
        }

        /// <summary>
        /// Check component id is valid or not
        /// </summary>
        /// <param name="componentID">Component id</param>
        /// <param name="e">Column is focused</param>
        public void CheckExistComponent(int componentID, BaseContainerValidateEditorEventArgs e)
        {
            ICProductEntities entity = (ICProductEntities)CurrentModuleEntity;
            //Data validation
            if (entity.MEMedicineComponentList.Exists("FK_MEComponentID", componentID))
            {
                e.ErrorText = ProductLocalizedResources1.ComponentExistMessage;
                e.Valid = false;
            }
        }

        public void CheckExistAccount(int accountID, BaseContainerValidateEditorEventArgs e)
        {
            ICProductEntities entity = (ICProductEntities)CurrentModuleEntity;
            //Data validation
            if (entity.ICProductAccountList.Exists("FK_ACAccountID", accountID))
            {
                e.ErrorText = ProductLocalizedResources1.AccountExistMessage;
                e.Valid = false;
            }
        }

        /// <summary>
        /// Remove an interacting product from the list
        /// </summary>
        public void RemoveInteractingProduct()
        {
            ICProductEntities entity = (ICProductEntities)CurrentModuleEntity;
            entity.InteractingProductList.RemoveSelectedRowObjectFromList();
        }
