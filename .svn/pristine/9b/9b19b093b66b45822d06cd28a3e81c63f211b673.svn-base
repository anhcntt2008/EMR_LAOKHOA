    public class MEParamValuesController : BaseBusinessController
    {
        public MEParamValuesController()
        {
            dal = new DALBaseProvider("MEParamValues", typeof(MEParamValuesInfo));
        }

        public List<MEParamValuesInfo> GetParamValueList(int fkMEParamID)
        {
            DataSet ds = dal.GetDataSet("MEParamValues_SelectByFK_MEParamID", fkMEParamID);
            List<MEParamValuesInfo> result = new List<MEParamValuesInfo>();
            if (ds.Tables.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    MEParamValuesInfo objParamsInfo = (MEParamValuesInfo)GetObjectFromDataRow(row);
                    result.Add(objParamsInfo);
                }
            }
            return result;
        }
    }
    #endregion
