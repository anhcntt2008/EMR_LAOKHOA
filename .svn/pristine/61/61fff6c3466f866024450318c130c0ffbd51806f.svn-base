        /// <summary>
        /// Get a visit lab of a patient on a day
        /// </summary>
        /// <param name="patientID">Patient id</param>
        /// <param name="labID">Lab id</param>
        /// <param name="date">Date the lab is performed on</param>
        /// <returns>Visit lab object</returns>
        public MEVisitLabsInfo GetVisitLabByPatientIDAndLabIDAndDate(int patientID, int labID, DateTime date)
        {
            DataSet ds = dal.GetDataSet("MEVisitLabs_GetVisitLabByPatientIDAndLabIDAndDate", patientID, labID, date);
            if (ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                MEVisitLabsInfo objVisitLabsInfo = (MEVisitLabsInfo)GetObjectFromDataRow(ds.Tables[0].Rows[0]);
                return objVisitLabsInfo;
            }
            return null;
        }

        /// <summary>
        /// Get patient visit recent labs by patient ID and patient visit ID
        /// </summary>
        /// <param name="patientID">Patient ID</param>
        /// <param name="patientVisitID">Patient Visit ID</param>
        /// <returns></returns>
        public DataTable GetPatientRecentLabs(int patientID, int patientVisitID)
        {
            DataSet result = new DataSet();
            List<MEVisitLabsInfo> visitLabsList = new List<MEVisitLabsInfo>();

            DataSet ds = new DataSet();
            List<string> columnList = new List<string>();
            MELabsController objLabsController = new MELabsController();
            MEVisitLabsController objVisitLabsController = new MEVisitLabsController();
            ds = dal.GetDataSet("MEVisitLabs_GetPatientRecentLabsByPatientVisitIDAndPatientID", patientVisitID, patientID);
            if (ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    MEVisitLabsInfo objVisitLabsInfo = (MEVisitLabsInfo)objVisitLabsController.GetObjectFromDataRow(row);
                    visitLabsList.Add(objVisitLabsInfo);
                }
            }
            var sortedVisitLabs = visitLabsList.OrderByDescending(m => m.MEVisitLabDate).ToList();
            foreach (var visitLab in sortedVisitLabs)
            {
                // Create caption of Gridview
                int labID = visitLab.FK_MELabID;
                DateTime visitDate = visitLab.MEVisitLabDate;
                int visitLabID = visitLab.MEVisitLabID;
                MELabsInfo objLabsInfo = (MELabsInfo)objLabsController.GetObjectByID(labID);
                if (objLabsInfo != null)
                {
                    if (objLabsInfo.MELabType != LabType.VitalSigns.ToString())
                    {
                        //DDCan [Show Visit Lab ID]
                        //string columnName = string.Format("{0}: {1}_{2}", objLabsInfo.MELabName, visitDate.ToShortDateString(), labID);
                        string columnName = string.Format("{0}_{1}_{2}_{3}", objLabsInfo.MELabName, labID, visitDate, visitLabID);

                        columnList.Add(columnName);

                        DataSet dst = dal.GetDataSet("MEVisitLabs_GetPatientRecentLabsByLabIDAndPatientIDAndPatientVisitIDAndVisitLabID", labID, patientID, patientVisitID, visitLabID);
                        if (dst.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
                        {
                            DataTable dt = (DataTable)dst.Tables[0];
                            dt.TableName = columnName;
                            result.Tables.Add(dt.Copy());
                        }
                    }
                }
            }
            DataTable recentLabTable = new DataTable();
            recentLabTable = ConstructRecentLabTable(columnList, result);
            return recentLabTable;
        }

        /// <summary>
        /// Get patient visit recent labs by patient ID and patient visit ID
        /// </summary>
        /// <param name="patientID">Patient ID</param>
        /// <param name="patientVisitID">Patient Visit ID</param>
        /// <returns></returns>
        public List<MEVisitLabsInfo> GetListPatientRecentLabs(int patientID, int patientVisitID)
        {
            List<MEVisitLabsInfo> visitLabsList = new List<MEVisitLabsInfo>();
            DataSet ds = new DataSet();
            MELabsController objLabsController = new MELabsController();
            MEVisitLabsController objVisitLabsController = new MEVisitLabsController();
            ds = dal.GetDataSet("MEVisitLabs_GetPatientRecentLabsByPatientVisitIDAndPatientID", patientVisitID, patientID);
            if (ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    MEVisitLabsInfo objVisitLabsInfo = (MEVisitLabsInfo)objVisitLabsController.GetObjectFromDataRow(row);
                    visitLabsList.Add(objVisitLabsInfo);
                }
            }

            return visitLabsList;
        }

        private DataTable ConstructRecentLabTable(List<string> columnList, DataSet ds)
        {
            DataTable recentLabsTable = new DataTable();
            foreach (string column in columnList)
            {
                recentLabsTable.Columns.Add(column, typeof(string));
            }
            foreach (string column in columnList)
            {
                for (int i = 0; i < ds.Tables[column].Rows.Count; i++)
                {
                    DataRow row = ds.Tables[column].Rows[i];
                    if (i == recentLabsTable.Rows.Count)
                    {
                        recentLabsTable.Rows.Add(recentLabsTable.NewRow());
                    }
                    recentLabsTable.Rows[i][column] = string.Format("{0} ({1})", row["MEVisitLabParamName"].ToString(), row["MEVisitLabParamValue"].ToString());
                }
            }
            return recentLabsTable;
        }

