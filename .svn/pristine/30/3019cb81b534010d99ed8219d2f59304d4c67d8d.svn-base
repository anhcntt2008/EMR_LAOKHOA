using System;
using System.Text;
using System.Collections;
using System.Collections.Generic;
using System.Data;
using System.Linq;
using System.Windows.Forms;
using DevExpress.XtraRichEdit;
using DevExpress.XtraRichEdit.API.Native;
using BOSComponent;
using BOSCommon;

namespace BOSERP.Modules.EmrShared
{
    #region EmrSharedModule
    //-----------------------------------------------------------
    //Generated By: BOS Studio
    //Class:EmrSharedModule
    //Created Date:Thursday, May 24, 2018
    //-----------------------------------------------------------

    public class EmrSharedModule : BaseModuleERP
    {
        private EmrSharedEntities _entity;
        private MEEmrsController _emrCtrl;

        public EmrSharedModule()
        {
            Name = "EmrShared";
            CurrentModuleEntity = new EmrSharedEntities();
            CurrentModuleEntity.Module = this;
            InitializeModule();
            ((BOSLookupEdit)Controls["fld_dkeFK_HRDepartmentFromID"]).EditValue = BOSApp.CurrentEmployeesInfo.FK_HRDepartmentID;
            _entity = CurrentModuleEntity as EmrSharedEntities;
            _emrCtrl = new MEEmrsController();
            InvalidateEmrShared();
        }

        internal void StopShareEmr(MEEmrsInfo emr)
        {
            _entity.MEEmrShareHistoryList.Invalidate(emr.MEEmrID);
            foreach (var item in _entity.MEEmrShareHistoryList)
            {
                item.MEEmrShareHistoryActive = false;
            }
            _entity.MEEmrShareHistoryList.SaveItemObjects();
        }

        public override void InvalidateAfterSearch(object sender, string strEventName)
        {
            base.InvalidateAfterSearch(sender, strEventName);
        }
        public void InvalidateEmrShared()
        {
            // 1523 Đã ký CA
            var mEEmrArchiveStatus = 0;
            if (BOSApp.CurrentUserGroupInfo.ADUserGroupRole == UserGroupRole.admin.ToString())
            {
                mEEmrArchiveStatus = 1;
            }
            var stateConds = GetStatePermiQueryConditionStr(TableName.MEEmrsTableName, false);
            var ds = _emrCtrl.GetAllActiveShared(((BOSLookupEdit)Controls["fld_dkeFK_HRDepartmentFromID"]).EditValue, mEEmrArchiveStatus, stateConds, string.Empty);
            _entity.MEEmrSharedList.Invalidate(ds);
        }

        internal void InvalidateSharedHistory(MEEmrsInfo mEEmrsInfo)
        {
            _entity.MEEmrShareHistoryList.Invalidate(mEEmrsInfo.MEEmrID);
        }
    }
    #endregion
}