using System;
using System.Collections.Generic;
using System.Data;
using BOSLib;


namespace BOSERP
{
    #region GEVersions
    //-----------------------------------------------------------
    //Generated By: BOS Studio
    //Class:GEVersionsController
    //Created Date:Saturday, November 09, 2013
    //-----------------------------------------------------------

    public class GEVersionsController : BaseBusinessController
    {
        public GEVersionsController()
        {
            dal = new DALBaseProvider("GEVersions", typeof(GEVersionsInfo));
        }

        public List<GEVersionsInfo> GetAllDbVersion()
        {
            var list = new List<GEVersionsInfo>();
            var ds = dal.GetAllObject();
            if (ds.Tables[0].Rows.Count <= 0) return list;
            for (var i = ds.Tables[0].Rows.Count - 1; i >= 0; i--)
            {
                var objVersionsInfo = (GEVersionsInfo)GetObjectFromDataRow(ds.Tables[0].Rows[i]);
                list.Add(objVersionsInfo);
            }
            return list;
        }

        public GEVersionsInfo GetDbVersion()
        {
            return base.GetDataObject("GEVersion_GetActive") as GEVersionsInfo;
        }

        public int CheckVersion(GEVersionsInfo dbVersion, string version)
        {
            if (dbVersion == null) return 1; //uthv bat buoc phai co version active trong db
            var oldVersion = new Version(dbVersion.ToString());
            var newVersion = new Version(version);
            var result = newVersion.CompareTo(oldVersion);
            return result;
        }

        public string CheckLicense()
        {
            String strSQL = @"declare @t table
                            (
                                i uniqueidentifier default newsequentialid(),
                                m as cast(i as char(36))
                            )
                            insert into @t default values;
                            select
                                substring(m,25,2) + '-' + 
                                substring(m,27,2) + '-' + 
                                substring(m,29,2) + '-' +
                                substring(m,31,2) + '-' +
                                substring(m,33,2) + '-' +
                                substring(m,35,2) AS MacAddress
                            FROM @t";
            System.Data.Common.DbCommand cmd = SqlDatabaseHelper.GetQuery(strSQL);
            DataSet ds = SqlDatabaseHelper.RunQuery(cmd);
            if (ds.Tables.Count > 0)
            {
                if (ds.Tables[0].Rows.Count > 0)
                {
                    return ds.Tables[0].Rows[0][0].ToString();
                }
            }

            return null;
        }
    }
    #endregion
}