    public class MEEmrActionParamsController : BaseBusinessController
    {
        public MEEmrActionParamsController()
        {
            dal = new DALBaseProvider("MEEmrActionParams", typeof(MEEmrActionParamsInfo));
        }
        public List<MEEmrActionParamsInfo> GetAllByActionID(int actionID)
        {
            var ds = dal.GetAllDataByForeignColumn("FK_MEEmrActionID", actionID);
            var businessObjectList = new List<MEEmrActionParamsInfo>();
            if (ds.Tables.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    var objBusinessObject = (MEEmrActionParamsInfo)SqlDatabaseHelper.GetObjectFromDataRow(row, dal.ObjectType);
                    businessObjectList.Add(objBusinessObject);
                }
            }
            return businessObjectList;
        }

        public List<MEEmrActionParamsInfo> GetAll()
        {
            return GetListBusinessObjects<MEEmrActionParamsInfo>(GetAllObjects());
        }
    }
