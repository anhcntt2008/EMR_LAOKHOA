using System;

namespace Clas.CHBase
{
    public class ParticipantConnectionDetails
    {
        public readonly string ApplicationSpecificId;
        public Guid PersonId;
        public Guid RecordId;

        public ParticipantConnectionDetails(string applicationSpecificId, Guid personId, Guid recordId)
        {
            ApplicationSpecificId = applicationSpecificId;
            PersonId = personId;
            RecordId = recordId;
        }
    }
}