using System;
using System.Data;
using System.Text;
using System.Collections.Generic;
using BOSLib;


namespace BOSERP
{
    #region MEEthnics
    //-----------------------------------------------------------
    //Generated By: BOS Studioa
    //Class:MEEthnicsController
    //Created Date:Thursday, June 21, 2012
    //-----------------------------------------------------------

    public class MEEthnicsController : BaseBusinessController
    {
        public MEEthnicsController()
        {
            dal = new DALBaseProvider("MEEthnics", typeof(MEEthnicsInfo));
        }

        /// <summary>
        /// Get all ethnic desc list
        /// </summary>
        /// <returns>The list of ethnic desc</returns>
        public List<string> GetAllEthnicDescToLowerList()
        {
            List<string> ethnicDescList = new List<string>();
            DataSet ds = GetAllObjects();
            if (ds.Tables[0].Rows.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    MEEthnicsInfo objEthnicsInfo = (MEEthnicsInfo)GetObjectFromDataRow(row);
                    ethnicDescList.Add(objEthnicsInfo.MEEthnicDesc.ToLower());
                }
            }
            return ethnicDescList;
        }

        /// <summary>
        /// Get all ethnic list
        /// </summary>
        /// <returns>The list of ethnic desc</returns>
        public List<MEEthnicsInfo> GetAllEthnic()
        {
            List<MEEthnicsInfo> ethnicList = new List<MEEthnicsInfo>();
            DataSet ds = GetAllObjects();
            if (ds.Tables[0].Rows.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    MEEthnicsInfo objEthnicsInfo = (MEEthnicsInfo)GetObjectFromDataRow(row);
                    ethnicList.Add(objEthnicsInfo);
                }
            }
            return ethnicList;
        }
    }
    #endregion
}