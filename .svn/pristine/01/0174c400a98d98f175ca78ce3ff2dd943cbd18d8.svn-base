select * from AAColumnAlias where AATableName ='MEEmrImagePatterns'
UPDATE AAColumnAlias set AAColumnAliasCaption= N'Tên ký hiệu' where AAColumnAliasName='MEEmrImagePatternName' and AATableName = 'MEEmrImagePatterns'
UPDATE AAColumnAlias set AAColumnAliasCaption= N'Mã ký hiệu' where AAColumnAliasName='MEEmrImagePatternNo' and AATableName = 'MEEmrImagePatterns'

select * from AAColumnAlias where AATableName ='METemplateParams'
UPDATE AAColumnAlias set AAColumnAliasCaption= N'Mã thẻ dữ liệu phân cấp' where AAColumnAliasName='METemplateParamPath' and AATableName = 'METemplateParams'

select * from AAColumnAlias where AATableName ='MEEmrActionParams'
UPDATE AAColumnAlias set AAColumnAliasCaption= N'Chỉ cập nhật thẻ đầu tiên tìm được' where AAColumnAliasName='MEEmrActionParamUpdateFirst' and AATableName = 'MEEmrActionParams'