    public class STFieldColumnsController : BaseBusinessController
    {
        public STFieldColumnsController()
        {
            dal = new DALBaseProvider("STFieldColumns", typeof(STFieldColumnsInfo));
        }

        public virtual DataSet GetFieldColumns()
        {
            var strQuery = String.Format("SELECT * FROM STFieldColumns ORDER BY STFieldColumnVisibleIndex");
            return dal.GetDataSet(strQuery);
        }


        public DataSet GetFieldColumnsByFieldID(int fieldID)
        {
            if (SystemMemCache.STFieldColumns != null)
            {
                var ds = new DataSet();
                var tb = SystemMemCache.STFieldColumns.Clone();
                ds.Tables.Add(tb);
                var sql = $"STFieldID = {fieldID}";
                var rows = SystemMemCache.STFieldColumns.Select(sql);
                foreach (var row in rows)
                {
                    tb.ImportRow(row);
                }
                return ds;
            }
            else
            {
                String query = String.Format("SELECT * FROM STFieldColumns WHERE STFieldID = {0} ORDER BY STFieldColumnVisibleIndex", fieldID);
                return GetDataSet(query);
            }
        }

        /// <summary>
        /// Get first field the column with the specified binding field name belongs to
        /// </summary>
        /// <param name="fieldName">Field name the column is bound to</param>
        /// <returns>Field object</returns>
        public STFieldsInfo GetFirstFieldByColumnFieldName(string columnFieldName)
        {
            DataSet ds = dal.GetDataSet("STFieldColumns_GetFirstFieldByColumnFieldName", columnFieldName);
            if (ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                STFieldsController objFieldsController = new STFieldsController();
                STFieldsInfo objFieldsInfo = (STFieldsInfo)objFieldsController.GetObjectFromDataRow(ds.Tables[0].Rows[0]);
                return objFieldsInfo;
            }
            return null;
        }

        public void DeleteGridSearchResultColsByIDStringAndUser(string fieldColIdStr, int groupID, int userID)
        {
            dal.GetDataSet("STFieldColumns_DeleteByIDStringAndUser", fieldColIdStr, groupID, userID);
        }
        public DataSet GetGridSearchResultColsByIDStringAndUser(string fieldColIdStr, int groupID, int userID)
        {
            return dal.GetDataSet("STFieldColumns_GetByIDStringAndUser", fieldColIdStr, groupID, userID);
        }

        public void DeleteByFieldIDAndUser(int fieldID, int groupID, int userID)
        {
            dal.GetDataSet("STFieldColumns_DeleteByFieldIDAndUser", fieldID, groupID, userID);
        }
        public DataSet GetByFieldIDAndUser(int fieldID, int groupID, int userID)
        {
            return dal.GetDataSet("STFieldColumns_GetByFieldIDAndUser", fieldID, groupID, userID);
        }

    }
    #endregion
