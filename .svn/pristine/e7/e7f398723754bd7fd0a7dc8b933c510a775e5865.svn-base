    public class BRPOSsController : BaseBusinessController
    {
        public BRPOSsController()
        {
            dal = new DALBaseProvider("BRPOSs", typeof(BRPOSsInfo));
        }

        /// <summary>
        /// Get POS info by POS id
        /// </summary>
        /// <param name="pOSID">POS id</param>
        /// <returns>POS info</returns>
        public BRPOSsInfo GetPOSByID(int pOSID)
        {
            BRPOSsInfo objPOSsInfo = new BRPOSsInfo();
            DataSet ds = dal.GetDataSet("BRPOSs_GetPOSByID", pOSID);
            if (ds.Tables[0].Rows.Count > 0)
            {
                objPOSsInfo = (BRPOSsInfo)GetObjectFromDataRow(ds.Tables[0].Rows[0]);
            }
            return objPOSsInfo;
        }
    }
    #endregion
}