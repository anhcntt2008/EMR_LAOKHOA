using System;
using System.Data;
using System.Text;
using System.Collections.Generic;
using BOSCommon;
using BOSLib;


namespace BOSERP
{
    #region MELabs
    //-----------------------------------------------------------
    //Generated By: BOS Studio
    //Class:MELabsController
    //Created Date:Saturday, September 24, 2011
    //-----------------------------------------------------------

    public class MELabsController : BaseBusinessController
    {
        public MELabsController()
        {
            dal = new DALBaseProvider("MELabs", typeof(MELabsInfo));
        }

        /// <summary>
        /// Get labs by type
        /// </summary>
        /// <param name="labType">Lab type</param>
        /// <returns>List of labs</returns>
        public List<MELabsInfo> GetLabsByType(string labType)
        {
            DataSet ds = dal.GetDataSet("MELabs_GetLabsByType", labType);
            List<MELabsInfo> labList = new List<MELabsInfo>();
            if (ds.Tables.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    MELabsInfo objLabsInfo = (MELabsInfo)GetObjectFromDataRow(row);
                    labList.Add(objLabsInfo);
                }
            }
            return labList;
        }

        public List<MELabsInfo> GetAllLabs()
        {
            DataSet ds = dal.GetAllObject();
            List<MELabsInfo> labList = new List<MELabsInfo>();
            if (ds.Tables.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    MELabsInfo objLabsInfo = (MELabsInfo)GetObjectFromDataRow(row);
                    labList.Add(objLabsInfo);
                }
            }
            return labList;
        }

        /// <summary>
        /// Get the lab being the vital signs
        /// </summary>
        /// <returns>Lab object</returns>
        public MELabsInfo GetVitalSigns()
        {
            List<MELabsInfo> labList = GetLabsByType(LabType.VitalSigns.ToString());
            if (labList.Count > 0)
            {
                return labList[0];
            }
            return null;
        }

       

    }
    #endregion
}