            return (List<ICProductSeriesInfo>)GetListFromDataSet(ds);
        }

        public override System.Collections.IList GetListFromDataSet(DataSet ds)
        {
            List<ICProductSeriesInfo> series = new List<ICProductSeriesInfo>();
