            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    ICProductSeriesInfo objProductSeriesInfo = (ICProductSeriesInfo)GetObjectFromDataRow(row);
                    series.Add(objProductSeriesInfo);
                }
            }
            return series;
        }
        /// <summary>
