        /// <summary>
        ///     uthv 17032017
        ///     Create Employee
        ///     Create User
        /// </summary>
        /// <param name="bRBranchId">this branch must from bs24x7 before</param>
        /// <param name="idGroup"></param>
        /// <param name="username"></param>
        /// <param name="pw"></param>
        /// <returns></returns>
        public int CreateEmployeeAndUserFromBs24X7(string employeeNo, int bRBranchId, int idGroup, string username, string pw,
            string fullName, string bacsi24x7Id = null, int specialId = 0, bool createUser = true)
        {
            // get branch, this branch must from bs24x7 before
            var branchCtrl = new BRBranchsController();
            var branch = branchCtrl.GetObjectByID(bRBranchId) as BRBranchsInfo;
            // get room, this room auto create before from bs24x7
            var roomCtrl = new HRDepartmentRoomsController();
            var room = roomCtrl.GetObjectByBs24x7ID(branch.BRBranchBacSi24x7Id) as HRDepartmentRoomsInfo;
            // create employee
            var empCtrl = new HREmployeesController();
            var emp = GetEmployeesInfoByBs24x7(bacsi24x7Id, bRBranchId);
            if (emp == null)
            {
                emp = new HREmployeesInfo
                {
                    FK_BRBranchID = bRBranchId,
                    FK_HRDepartmentID = room.FK_HRDepartmentID,
                    FK_HRDepartmentRoomID = room.HRDepartmentRoomID,
                    HREmployeeNo = employeeNo,
                    HREmployeeName = fullName,
                    FK_MESpecialismID = specialId,
                    HREmployeeBacSi24x7Id = bacsi24x7Id,
                    HREmployeeStartWorkingTime = new DateTime(1970, 1, 1, 7, 0, 0),
                    HREmployeeEndWorkingTime = new DateTime(1970, 1, 1, 17, 0, 0)
            };
                empCtrl.CreateObject(emp);
            }

            if (!createUser) return emp.HREmployeeID;
            var userCtrl = new ADUsersController();
            var objUsersInfo = new ADUsersInfo
            {
                FK_HREmployeeID = emp.HREmployeeID,
                ADUserGroupID = idGroup,
                ADUserName = username,
                ADPassword = pw,
                ADUserStyle = "Skin",
                ADUserStyleSkin = "Black",
                ADUserEndTimeDefault = 1,
                ADUserBranchId = bRBranchId
            };
            var userId = userCtrl.CreateUser(objUsersInfo);
            var listBranch = _brBranchsController.GetListBusinessObjects().Cast<BRBranchsInfo>();
            var listModule = Constant.ListModuleFree;
            var moduleList = new List<int>();
            for (var i = 0; i < listModule.GetLength(0); i++)
            {
                var modules = listModule[i, 1];
                moduleList.AddRange(modules.Split(',').Select(int.Parse));
            }
            foreach (var brBranchsInfo in listBranch)
            {
                if(brBranchsInfo.BRBranchID==0)
                    continue;
                _dataViewPermissionsController.PermissionViewData(userId,brBranchsInfo.BRBranchID, moduleList);
            }
            return userId;
        }

