        /// <summary>
        ///     Get the sale summary of an employee
        /// </summary>
        /// <param name="objEmployeesInfo">Employee object is used to retrive data</param>
        /// <param name="from">Date which the result is filtered from</param>
        /// <param name="to">Date which the result is filtered to</param>
        public void GetSaleSummary(HREmployeesInfo objEmployeesInfo, DateTime? from, DateTime? to)
        {
            var cmd = dal.GetStoredProcedureCommand("HREmployees_GetSaleSummary");
            dal.AddParameter(cmd, "HREmployeeID", DbType.Int32, ParameterDirection.Input, objEmployeesInfo.HREmployeeID);
            dal.AddParameter(cmd, "DateFrom", DbType.DateTime, ParameterDirection.Input, from);
            dal.AddParameter(cmd, "DateTo", DbType.DateTime, ParameterDirection.Input, to);
            dal.AddParameter(cmd, "TotalSaleAmount", DbType.Double, ParameterDirection.Output,
                objEmployeesInfo.TotalSaleAmount);
            dal.AddParameter(cmd, "TotalSaleQty", DbType.Double, ParameterDirection.Output,
                objEmployeesInfo.TotalSaleQty);
            dal.GetDataSet(cmd);
            objEmployeesInfo.TotalSaleAmount = Convert.ToDouble(dal.GetParameterValue(cmd, "TotalSaleAmount"));
            objEmployeesInfo.TotalSaleQty = Convert.ToDouble(dal.GetParameterValue(cmd, "TotalSaleQty"));
        }

