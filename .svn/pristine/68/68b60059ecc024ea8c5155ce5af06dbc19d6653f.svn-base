        public HREmployeesInfo GetEmployeesInfoByBs24x7(string bacsi24x7Id, int brachId)
        {
            var ds =
                dal.GetDataSet(
                    $"SELECT HREmployeeID FROM HREmployees WHERE HREmployeeBacSi24x7Id = '{bacsi24x7Id}' AND FK_BRBranchID='{brachId}'");
            HREmployeesInfo employee = null;
            if (ds == null || ds.Tables.Count == 0) return null;
            if (ds.Tables[0].Rows.Count != 0)
                employee = (HREmployeesInfo)GetObjectFromDataRow(ds.Tables[0].Rows[0]);
            return employee;
        }
