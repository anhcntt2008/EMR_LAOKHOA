using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;

namespace Clas.Model.DrugInfo
{
   public class DrugInfoPatient
    {
        public string code { get; set; }
        public string name { get; set; }
        public string sex { get; set; }
        public string dob { get; set; }
        public int age { get; set; }
        public int weight { get; set; }
        public int height { get; set; }
        public int pulse { get; set; }
        public int pregnant { get; set; }
        public bool smoking { get; set; }
        public bool alcohol { get; set; }
        public bool breast_feeding { get; set; }
        public int systolic { get; set; }
        public int diastolic { get; set; }
        public List<string> base_diseases { get; set; }
        public List<string> allergic_uniis { get; set; }
        public List<string> allergic_drugs { get; set; }
    }
}
