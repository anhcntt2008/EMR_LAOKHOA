    public class HRRoomBedsController : BaseBusinessController
    {
        public HRRoomBedsController()
        {
            dal = new DALBaseProvider("HRRoomBeds", typeof(HRRoomBedsInfo));
        }

        /// <summary>
        /// Get room bed list by specialism ID
        /// </summary>
        /// <param name="specialismID">Specialism ID</param>
        /// <returns>Room bed list</returns>
        public DataSet GetRoomBedsListBySpecialismID(int specialismID)
        {
            return dal.GetDataSet("HRRoomBeds_GetRoomBedsListBySpecialismID", specialismID);
        }
        public DataSet GetRoomBedsListByDepartmentRoomID(int? departmentRoomID)
        {
            return dal.GetDataSet("HRRoomBeds_GetRoomBedsListByDepartmentRoomID", departmentRoomID);
        }

        public List<HRRoomBedsInfo> GetAllRoomBedList()
        {
            DataSet ds = dal.GetDataSet("HRRoomBeds_GetAllRoomBed");
            List<HRRoomBedsInfo> roomBedList = new List<HRRoomBedsInfo>();
            if (ds.Tables.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    HRRoomBedsInfo objRoomBedsInfo = (HRRoomBedsInfo)GetObjectFromDataRow(row);
                    roomBedList.Add(objRoomBedsInfo);
                }
            }
            return roomBedList;
        }
        public DataSet GetRoomBedsListByDepartmentID(int? departmentID)
        {
            return dal.GetDataSet("HRRoomBeds_GetRoomBedsListByDepartmentID", departmentID);
        }
    }
    #endregion
