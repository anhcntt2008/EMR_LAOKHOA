        //DDCan [MOD] [18/11/2013] [DB centre] [GENumbering issue], START
        /// <summary>
        /// Get numbering by name and branch id
        /// </summary>
        /// <param name="name"></param>
        /// <param name="branchId"></param>
        /// <returns></returns>
        public GENumberingInfo GetObjectByNameAndBranchID(string name, int branchId)
        {
            DataSet ds = dal.GetDataSet("GENumbering_GetObjectByNameAndBranchID", name, branchId);
            if (ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            {
                GENumberingInfo objNumberingInfo = (GENumberingInfo)GetObjectFromDataRow(ds.Tables[0].Rows[0]);
                return objNumberingInfo;
            }
            return null;
        }
        //DDCan [MOD] [18/11/2013] [DB centre] [GENumbering issue], END

        //DDCan [MOD] [18/11/2013] [DB centre] [GENumbering issue], START
        /// <summary>
        /// Get numbering list by branch id
        /// </summary>
        /// <param name="branchId"></param>
        /// <returns></returns>
        public List<GENumberingInfo> GetNumberingListByBranchID(int branchId)
        {
            List<GENumberingInfo> numberingList = new List<GENumberingInfo>();
            DataSet ds = dal.GetDataSet("GENumbering_GetNumberingListByBranchID", branchId);
            if (ds.Tables.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    GENumberingInfo objNumberingInfo = (GENumberingInfo)GetObjectFromDataRow(row);
                    numberingList.Add(objNumberingInfo);
                }
            }
            return numberingList;
        }
