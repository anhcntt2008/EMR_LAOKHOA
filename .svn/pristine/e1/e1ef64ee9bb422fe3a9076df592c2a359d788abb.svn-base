    public class STModuleColumnsController : BaseBusinessController
    {
        public STModuleColumnsController()
        {
            dal = new DALBaseProvider("STModuleColumns", typeof(STModuleColumnsInfo));
        }

        //STModuleColumns_GetByTableName
        public STModuleColumnsInfo GetByTableName(string tableName)
        {
            string query = "select * from STModuleColumns where IsActive = 1 and STModuleTableName = '" + tableName + "'";
            DataSet ds = GetDataSet(query);
            if (ds.Tables[0].Rows.Count > 0)
                return (STModuleColumnsInfo)dal.GetObjectFromDataRow(ds.Tables[0].Rows[0]);
            else
                return null;
        }

        public STModuleColumnsInfo GetByColumnName(string columnName)
        {
            string query = "select * from STModuleColumns where IsActive = 1 and STModuleColumnName = '" + columnName + "'";
            DataSet ds = GetDataSet(query);
            if (ds.Tables[0].Rows.Count > 0)
                return (STModuleColumnsInfo)dal.GetObjectFromDataRow(ds.Tables[0].Rows[0]);
            else
                return null;
        }
    }
    #endregion
}