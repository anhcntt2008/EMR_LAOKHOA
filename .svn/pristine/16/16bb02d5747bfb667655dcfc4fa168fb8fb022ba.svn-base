        /// <param name="fromDate">Date the cost is calculated from</param>
        /// <param name="toDate">Date the cost is calculated to</param>
        /// <returns>Total inventory cost</returns>
        public double GetTotalInventoryCostByProductIDAndDate(int productID, DateTime? fromDate, DateTime? toDate)
        {
            double totalCost = Convert.ToDouble(dal.GetSingleValue("ICReceiptItems_GetTotalInventoryCostByProductIDAndDate", productID, fromDate, toDate));
            return totalCost;
        }

        /// <summary>
