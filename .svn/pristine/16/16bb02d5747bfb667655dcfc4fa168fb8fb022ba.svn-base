        /// <param name="toDate">Date the quantity is calculated to</param>
        /// <returns>Total receipted quantity</returns>
        public double GetTotalQtyByProductIDAndDate(int productID, DateTime? fromDate, DateTime? toDate)
        {
            double totalQty = Convert.ToDouble(dal.GetSingleValue("ICReceiptItems_GetTotalQtyByProductIDAndDate", productID, fromDate, toDate));            
            return totalQty;
        }

