	@MEEmrTransferHistoryID int,
	@AAStatus varchar(50),
	@AACreatedUser nvarchar(50),
	@AACreatedDate datetime,
	@AAUpdatedUser nvarchar(50),
	@AAUpdatedDate datetime,
	@MEEmrTransferHistoryNo varchar(50),
	@MEEmrTransferHistoryDate datetime,
	@FK_MEEmrID int,
	@FK_HREmployeeFromID int,
	@FK_HREmployeeToID int,
	@FK_HRDepartmentFromID int,
	@FK_HRDepartmentToID int,
	@MEEmrTransferHistoryCurrent bit,
	@MEEmrTransferHistoryRemark nvarchar(4000)

AS
BEGIN
SET NOCOUNT ON
UPDATE [dbo].[MEEmrTransferHistories] SET
	[AAStatus]=@AAStatus,
	[AACreatedUser]=@AACreatedUser,
	[AACreatedDate]=@AACreatedDate,
	[AAUpdatedUser]=@AAUpdatedUser,
	[AAUpdatedDate]=@AAUpdatedDate,
	[MEEmrTransferHistoryNo]=@MEEmrTransferHistoryNo,
