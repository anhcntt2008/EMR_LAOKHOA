using System;
using System.Text;
using System.Collections;
using System.Collections.Generic;
using System.Data;
using BOSERP.Modules.EmrSymbol.UI;
using System.Linq;
using System.Windows.Forms;
using DevExpress.XtraRichEdit;
using DevExpress.XtraRichEdit.API.Native;

namespace BOSERP.Modules.EmrSymbol
{
    #region EmrSymbolModule
    //-----------------------------------------------------------
    //Generated By: BOS Studio
    //Class:EmrSymbolModule
    //Created Date:Thursday, May 24, 2018
    //-----------------------------------------------------------

    public class EmrSymbolModule : BaseModuleERP
    {
        private EmrSymbolEntities _entity;
        private MEEmrSymbolsController _symbolCtrl;
        private RichEditControl _richEditControl1;

        public EmrSymbolModule()
        {
            Name = "EmrSymbol";
            CurrentModuleEntity = new EmrSymbolEntities();
            CurrentModuleEntity.Module = this;
            InitializeModule();
            _entity = CurrentModuleEntity as EmrSymbolEntities;
            _symbolCtrl = new MEEmrSymbolsController();
            _richEditControl1 = new RichEditControl();
            InvalidateModuleObjects();
        }
        public void InvalidateModuleObjects()
        {
            var ds = _symbolCtrl.GetAllObjects();
            _entity.MEEmrSymbolList.Invalidate(ds);
            foreach (var item in _entity.MEEmrSymbolList)
            {
                _richEditControl1.CreateNewDocument(false);
                if (item.MEEmrSymbolChar > 0)
                {
                    var sym = string.Format("SYMBOL {0} \\f \"{1}\" \\s {2}", item.MEEmrSymbolChar, item.MEEmrSymbolFont, 16);
                    var rang = _richEditControl1.Document.InsertText(_richEditControl1.Document.Range.Start, sym);
                    var field = _richEditControl1.Document.Fields.Create(rang);
                }
                else
                {
                    _richEditControl1.Document.DefaultCharacterProperties.FontName = "Times New Roman";
                    _richEditControl1.Document.DefaultCharacterProperties.FontSize = 16;
                    var rang = _richEditControl1.Document.InsertText(_richEditControl1.Document.Range.Start, item.MEEmrSymbolStr);
                }
                item.RtfText = _richEditControl1.RtfText;
            }
        }
        public override void InvalidateAfterSearch(object sender, string strEventName)
        {
            base.InvalidateAfterSearch(sender, strEventName);
        }
        internal void DeleteSymbolFromList()
        {
            _entity.MEEmrSymbolList.RemoveSelectedRowObjectFromList();
        }

        public void ActionSaveList()
        {
            _entity.MEEmrSymbolList.SaveItemObjects();
            InvalidateModuleObjects();
        }
    }
    #endregion
}