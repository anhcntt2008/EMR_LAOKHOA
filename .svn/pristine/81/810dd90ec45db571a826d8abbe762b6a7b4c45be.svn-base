            return list;
        }
        public List<string> GetAllEmrNoByPatient(int FK_MEPatientID)
        {
            var result = new List<string>();
            var ds = dal.GetDataSet($"SELECT DISTINCT [MEEmrNo] FROM [MEEmrs] WHERE AAStatus = 'Alive' AND [FK_MEPatientID] = {FK_MEPatientID}");
            if (ds.Tables.Count > 0)
                result = ds.Tables[0].AsEnumerable()
                            .Select(r => r.Field<string>(0)).ToList();

            return result;
        }

