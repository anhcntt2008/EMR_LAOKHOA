        public List<String> DistinctRoomByDept(int departmentId)
        {
            var list = new List<String>();
            var ds = SqlDatabaseHelper.RunStoredProcedure("MEEmrs_DistinctRoomByDept", departmentId);
            if (ds.Tables.Count > 0)
            {
                if (ds.Tables[0].Rows.Count > 0)
