        private List<MEEmrsInfo> MappingToList(DataSet ds)
        {
            List<MEEmrsInfo> businessObjectList = new List<MEEmrsInfo>();
            if (ds.Tables.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    MEEmrsInfo objBusinessObject = (MEEmrsInfo)SqlDatabaseHelper.GetObjectFromDataRow(row, dal.ObjectType);
                    objBusinessObject.MEEmrFullName = string.Format("{0} - {1} - {2}", objBusinessObject.MEEmrNo,
                    objBusinessObject.MEEmrCreatedDate.ToString("dd/MM/yyyy"),
                    objBusinessObject.MEEmrEndDate.Year == 9999 ? "*" : objBusinessObject.MEEmrEndDate.ToString("dd/MM/yyyy"));
                    businessObjectList.Add(objBusinessObject);
                }
            }
            return businessObjectList;
        }

