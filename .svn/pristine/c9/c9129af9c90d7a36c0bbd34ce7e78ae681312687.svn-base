        /// <summary>
        /// Get Original List From Other Tables
        /// </summary>
        /// <returns></returns>
        public DataTable GetOriginalProductLocationBranchPrices(int? locationID, int? branchID, int? departmentID, int? productGroupID, bool viewFuturePrice)
        {
            DataSet ds = dal.GetDataSet("ICProductLocationBranchPrices_GetOriginalProductLocationBranchPrices", locationID, branchID, departmentID, productGroupID);

            List<ICProductLocationBranchPricesInfo> list = new List<ICProductLocationBranchPricesInfo>();
            if (ds.Tables.Count > 0)
            {
                foreach(DataRow row in ds.Tables[0].Rows)
                {
                    ICProductLocationBranchPricesInfo objProductLocationBranchPricesInfo = (ICProductLocationBranchPricesInfo)GetObjectFromDataRow(row);
                    list.Add(objProductLocationBranchPricesInfo);
                }
            }

            BRBranchsController objBranchsController = new BRBranchsController();
            List<BRBranchsInfo> branchs = new List<BRBranchsInfo>();

            branchs = objBranchsController.GetAllBranches();
            if (branchID > 0)
                branchs = branchs.Where(p => p.BRBranchID == branchID).ToList();
            if (locationID > 0)
                branchs = branchs.Where(p => p.FK_GELocationID == locationID).ToList();

            DataTable dt = new DataTable();
            dt.Columns.Add(new DataColumn("ICProductID"));
            dt.Columns.Add(new DataColumn("ICProductNo"));
            dt.Columns.Add(new DataColumn("ICProductDesc"));
            foreach (BRBranchsInfo objBranchsInfo in branchs)
            {
                dt.Columns.Add(new DataColumn(objBranchsInfo.BRBranchID.ToString() + "CurrentPrice", typeof(double)));
                if (viewFuturePrice)
                {
                    dt.Columns.Add(new DataColumn(objBranchsInfo.BRBranchID.ToString() + "FuturePrice", typeof(double)));
                }
            }

            List<ICProductLocationBranchPricesInfo>[] locationBranchPriceList = new List<ICProductLocationBranchPricesInfo>[branchs.Count];
            for (int i = 0; i < branchs.Count; i++)
            {
                locationBranchPriceList[i] = (from pp in list
                                              where pp.FK_BRBranchID == branchs[i].BRBranchID
                                              select new ICProductLocationBranchPricesInfo
                                              {
                                                  ICProductNo = pp.ICProductNo,
                                                  ICProductDesc = pp.ICProductDesc,
                                                  FK_BRBranchID = pp.FK_BRBranchID,
                                                  FK_GELocationID = pp.FK_GELocationID,
                                                  FK_ICProductID = pp.FK_ICProductID,
                                                  ICProductLocationBranchPriceCurrentPrice = pp.ICProductLocationBranchPriceCurrentPrice,
                                                  ICProductLocationBranchPriceFuturePrice = pp.ICProductLocationBranchPriceFuturePrice
                                              }).ToList();
            }

            ICProductsController objProductsController = new ICProductsController();
            List<ICProductsInfo> productList = objProductsController.GetAllProducts();
            if (productGroupID > 0)
                productList = productList.Where(p => p.FK_ICProductGroupID == productGroupID).ToList();
            if (departmentID > 0)
                productList = productList.Where(p => p.FK_ICDepartmentID == departmentID).ToList();

            foreach (ICProductsInfo objProductsInfo in productList)
            {
                DataRow newRow = dt.NewRow();
                newRow["ICProductID"] = objProductsInfo.ICProductID;
                newRow["ICProductNo"] = objProductsInfo.ICProductNo;
                newRow["ICProductDesc"] = objProductsInfo.ICProductDesc;
                for (int i = 0; i < branchs.Count; i++)
                {
                    double currentPrice = 0;
                    double futurePrice = 0;

                    if (locationBranchPriceList[i].Count > 0)
                    {
                        var listCurrentPrice = from pl in locationBranchPriceList[i]
                                               where pl.FK_ICProductID == objProductsInfo.ICProductID
                                               select new { CurrentPrice = pl.ICProductLocationBranchPriceCurrentPrice };
                        if (listCurrentPrice.Count() > 0)
                            currentPrice = listCurrentPrice.FirstOrDefault().CurrentPrice;

                        var listFuturePrice = from pl in locationBranchPriceList[i]
                                              where pl.FK_ICProductID == objProductsInfo.ICProductID
                                              select new { FuturePrice = pl.ICProductLocationBranchPriceFuturePrice };
                        if (listFuturePrice.Count() > 0)
                            futurePrice = listFuturePrice.FirstOrDefault().FuturePrice;
                    }

                    newRow[branchs[i].BRBranchID.ToString() + "CurrentPrice"] = currentPrice;
                    if (viewFuturePrice)
                    {
                        newRow[branchs[i].BRBranchID.ToString() + "FuturePrice"] = futurePrice;
                    }
                }
                dt.Rows.Add(newRow);
            }

            return dt;
        }

