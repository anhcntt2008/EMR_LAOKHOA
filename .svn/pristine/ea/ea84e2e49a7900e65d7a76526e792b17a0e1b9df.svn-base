    public class GELookupTablesController : BaseBusinessController
    {
        public GELookupTablesController()
        {
            dal = new DALBaseProvider("GELookupTables", typeof(GELookupTablesInfo));
        }

        public GELookupTablesInfo GetObjectByTableName(String tableName)
        {
            //String query = String.Format("SELECT * FROM GELookupTables WHERE AAStatus = 'Alive' AND GELookupTableName = '{0}'", tableName);
            //DataSet ds = GetDataSet(query);
            //if (ds.Tables.Count > 0 && ds.Tables[0].Rows.Count > 0)
            //    return (GELookupTablesInfo)GetObjectFromDataRow(ds.Tables[0].Rows[0]);
            //return null;

            if (SystemMemCache.GE_LOOKUP_TABLES == null)
            {
                var strQuery = "SELECT * FROM GELookupTables WHERE AAStatus = 'Alive'";
                SystemMemCache.GE_LOOKUP_TABLES = dal.GetDataSet(strQuery).Tables[0];
            }
            var row = SystemMemCache.GE_LOOKUP_TABLES.Select($"GELookupTableName = '{tableName}'").FirstOrDefault();
            if (row != null)
                return (GELookupTablesInfo)GetObjectFromDataRow(row);
            return null;
        }
        public override object GetObjectByName(string strObjectName)
        {
            return GetObjectByTableName(strObjectName);
            //return base.GetObjectByName(strObjectName);
        }
    }
