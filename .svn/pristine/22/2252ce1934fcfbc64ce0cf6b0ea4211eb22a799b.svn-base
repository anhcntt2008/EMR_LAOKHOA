        public override IList GetListFromDataSet(DataSet ds)
        {
            var products = new List<ICProductsInfo>();
            if (ds.Tables.Count > 0)
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    var objProductsInfo = (ICProductsInfo) GetObjectFromDataRow(row);
                    products.Add(objProductsInfo);
                }
            return products;
        }

