            int? stockID)
        {
            var ds = dal.GetDataSet("ICProducts_GetProductList2", departmentID, productGroupID, supplierID, stockID);
            var productList = new List<ICProductsInfo>();
            if (ds.Tables.Count > 0)
                foreach (DataRow row in ds.Tables[0].Rows)
