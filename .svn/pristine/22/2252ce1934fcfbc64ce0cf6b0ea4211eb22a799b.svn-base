                    var objProductsInfo = (ICProductsInfo) GetObjectFromDataRow(row);
                    productList.Add(objProductsInfo);
                }
            return productList;
        }

        public List<ICProductsInfo> AppendComponentNameForProductAndRemoveZeroInventoryStockQuantity(DataSet dsProduct)
        {
            var productList = new List<ICProductsInfo>();
            var objMedicineComponentsController = new MEMedicineComponentsController();
            if (dsProduct.Tables.Count > 0)
                foreach (DataRow row in dsProduct.Tables[0].Rows)
                {
                    var objProductsInfo = (ICProductsInfo) GetObjectFromDataRow(row);
                    if (objProductsInfo.ICInventoryStockQuantity >= 0)
                    {
                        //Get component name                        
                        var medicineComponentList =
                            objMedicineComponentsController.GetMedicineComponentListByProductID(
                                objProductsInfo.ICProductID);
                        if (medicineComponentList.Count > 0)
                        {
                            var medicineComponent = "";
                            foreach (var objMedicineComponentsInfo in medicineComponentList)
                                medicineComponent = medicineComponent + objMedicineComponentsInfo.MEComponentName + ", ";
                            medicineComponent = medicineComponent.Substring(0, medicineComponent.Length - 2);
                            objProductsInfo.MEComponentName = medicineComponent;
                        }
                        else
                        {
                            objProductsInfo.MEComponentName = "";
                        }
                        if (objProductsInfo.ICProductType == ProductType.Medicine.ToString())
                            productList.Add(objProductsInfo);
                    }
                }
            return productList;
        }

        /// <summary>
        ///     UtHV
        ///     10022017
        ///     Khong cho bs search cac thuoc co trang thai khong hoat dong
        /// </summary>
        /// <param name="dsProduct"></param>
        /// <returns></returns>
        public List<ICProductsInfo>
            AppendComponentNameForProductAndRemoveZeroInventoryStockQuantityAndRemoveInactiveProducts(DataSet dsProduct, int stockID)
        {
            var productList = new List<ICProductsInfo>();
            var objMedicineComponentsController = new MEMedicineComponentsController();
            if (dsProduct.Tables.Count > 0)
                foreach (DataRow row in dsProduct.Tables[0].Rows)
                {
                    var objProductsInfo = (ICProductsInfo) GetObjectFromDataRow(row);

                    //Khong cho bs search cac thuoc co trang thai khong hoat dong
                    if (objProductsInfo.ICProductActiveCheck == false)
                        continue;

                    if (objProductsInfo.ICInventoryStockQuantity > 0)
                    {
                        //Get component name                        
                        var medicineComponentList =
                            objMedicineComponentsController.GetMedicineComponentListByProductID(
                                objProductsInfo.ICProductID);
                        if (medicineComponentList.Count > 0)
                        {
                            var medicineComponent = "";
                            foreach (var objMedicineComponentsInfo in medicineComponentList)
                                medicineComponent = medicineComponent + objMedicineComponentsInfo.MEComponentName + ", ";
                            medicineComponent = medicineComponent.Substring(0, medicineComponent.Length - 2);
                            objProductsInfo.MEComponentName = medicineComponent;
                        }
                        else
                        {
                            objProductsInfo.MEComponentName = "";
                        }

                        //DDCan [ADD] [25/07/2017] [Quatity can sale], START
                        int saleOrderStockID = 0;
                        ICStocksController objStocksController = new ICStocksController();
                        saleOrderStockID = objStocksController.GetStockBySaleStockID(stockID, StockType.SaleOrder.ToString()).ICStockID;

                        ICInventoryStocksController objInventoryStocksController = new ICInventoryStocksController();
                        //double saleQuantity = objInventoryStocksController.GetStockQuantityByProductAndStock(objProductsInfo.ICProductID, saleOrderStockID);
                        //objProductsInfo.ICInventoryStockQuantity = objProductsInfo.ICInventoryStockQuantity - saleQuantity;
                        //DDCan [ADD] [25/07/2017] [Quatity can sale], END

                        //DDCan [MOD] [25/07/2017] [Quatity can sale], START
                        //if (objProductsInfo.ICProductType == ProductType.Medicine.ToString())
                        //    productList.Add(objProductsInfo);
                        if (objProductsInfo.ICProductType == ProductType.Medicine.ToString() && objProductsInfo.ICInventoryStockQuantity >= 0)
                            productList.Add(objProductsInfo);
                        //DDCan [MOD] [25/07/2017] [Quatity can sale], END
                    }
                }
            return productList;
        }

