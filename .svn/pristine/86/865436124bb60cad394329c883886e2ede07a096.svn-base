    public class MEOccupationsController : BaseBusinessController
    {
        public MEOccupationsController()
        {
            dal = new DALBaseProvider("MEOccupations", typeof(MEOccupationsInfo));
        }

        /// <summary>
        /// Get all occupation desc list
        /// </summary>
        /// <returns>The list of occupation desc</returns>
        public List<string> GetAllOccupationDescToLowerList()
        {
            List<string> occupationDescList = new List<string>();
            DataSet ds = GetAllObjects();
            if (ds.Tables[0].Rows.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    MEOccupationsInfo objOccupationsInfo = (MEOccupationsInfo)GetObjectFromDataRow(row);
                    occupationDescList.Add(objOccupationsInfo.MEOccupationDesc.ToLower());
                }
            }
            return occupationDescList;
        }

        /// <summary>
        /// Get all occupation list
        /// </summary>
        /// <returns>The list of occupation desc</returns>
        public List<MEOccupationsInfo> GetAllOccupation()
        {
            List<MEOccupationsInfo> occupationList = new List<MEOccupationsInfo>();
            DataSet ds = GetAllObjects();
            if (ds.Tables[0].Rows.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    MEOccupationsInfo objOccupationsInfo = (MEOccupationsInfo)GetObjectFromDataRow(row);
                    occupationList.Add(objOccupationsInfo);
                }
            }
            return occupationList;
        }
    }
    #endregion
}