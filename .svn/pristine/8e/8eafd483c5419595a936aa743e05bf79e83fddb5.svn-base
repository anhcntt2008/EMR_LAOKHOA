using System;
using System.Text;
using System.Collections;
using System.Collections.Generic;
using System.Data;
using System.Windows;
using System.Windows.Forms;
using BOSLib;

namespace BOSERP.Modules.MEParamLookup
{
    #region MEParamLookupModule
    //-----------------------------------------------------------
    //Generated By: BOS Studio
    //Class:StudentModule
    //Created Date:Monday, April 9, 2018
    //-----------------------------------------------------------

    public class MEParamLookupModule : BaseModuleERP
    {
        public MEParamLookupModule()
        {
            Name = "MEParamLookup";
            CurrentModuleEntity = new MEParamLookupEntities();
            CurrentModuleEntity.Module = this;
            InitializeModule();
        }

        internal void DeleteLookupData()
        {
            MEParamLookupEntities entity = (MEParamLookupEntities)CurrentModuleEntity;
            entity.MEParamLookupDataList.RemoveSelectedRowObjectFromList();
        }

        public override int ActionSave()
        {
            MEParamLookupEntities entity = (MEParamLookupEntities)CurrentModuleEntity;
            var paramLookup = entity.MainObject as MEParamLookupsInfo;
            var paramLookupData = entity.MEParamLookupDataList;
            if (paramLookupData.Count > 500 && paramLookup.MEParamLookupID > 0)
            {
                if (System.Windows.Forms.MessageBox.Show($"[Yes] Chỉ cập nhật Thông tin. [No] Cập nhật tất cả.", "Thông báo dữ liệu lớn", MessageBoxButtons.YesNo, MessageBoxIcon.Question) == DialogResult.Yes)
                {
                    var paramLookupId = paramLookup.MEParamLookupID;
                    (new MEParamLookupsController()).UpdateObject(paramLookup);
                    ModuleAfterSaved(paramLookupId);
                    return paramLookupId;
                }
            }
            BOSProgressBar.Start("Đang lưu dữ liệu....");
            var id = base.ActionSave();
            BOSProgressBar.Close();
            return id;
        }
    }
    #endregion
}