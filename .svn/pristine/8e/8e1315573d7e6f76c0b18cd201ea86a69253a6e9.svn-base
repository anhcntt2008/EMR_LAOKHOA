        public List<ARInvoiceItemsInfo> GetInvoiceItemsByVisitAndProductType4Insurance(int visitID, string productType)
        {
            DataSet ds = dal.GetDataSet("ARInvoiceItems_GetInvoiceItemsByVisitAndProductType", visitID, productType);
            List<ARInvoiceItemsInfo> invoiceItemList = new List<ARInvoiceItemsInfo>();
            if (ds.Tables[0].Rows.Count > 0)
            {
                ARInvoiceItemsController objInvoiceItemsController = new ARInvoiceItemsController();
                foreach (DataRow dr in ds.Tables[0].Rows)
                {
                    ARInvoiceItemsInfo objInvoiceItemsInfo = new ARInvoiceItemsInfo();
                    objInvoiceItemsInfo = (ARInvoiceItemsInfo)objInvoiceItemsController.GetObjectFromDataRow(dr);

                    //Chỉ lấy những item có bảo hiểm thanh toán
                    if (objInvoiceItemsInfo.ARInvoiceItemPayer2Amount > 0)
                    {
                        invoiceItemList.Add(objInvoiceItemsInfo);
                    }
                }
            }
            return invoiceItemList;
