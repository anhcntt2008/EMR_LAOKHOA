    public class HRLevelsController : BaseBusinessController
    {
        public HRLevelsController()
        {
            dal = new DALBaseProvider("HRLevels", typeof(HRLevelsInfo));
        }

        public List<HRLevelsInfo> GetAllList()
        {
            DataSet ds = dal.GetDataSet("HRLevels_SelectAll");
            List<HRLevelsInfo> level = new List<HRLevelsInfo>();
            if (ds.Tables.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    HRLevelsInfo objLevelsInfo = (HRLevelsInfo)GetObjectFromDataRow(row);
                    level.Add(objLevelsInfo);
                }
            }
            return level;
        }
    }
    #endregion
