        public DataSet GetInvoiceDatasetByListOfBranchID(string invoiceNo,
                                        int? customerID,
                                        int? branchID,
                                        int? employeeID,
                                        string invoiceType,
                                        DateTime? dateFrom,
                                        DateTime? dateTo, List<BRBranchsInfo> branchList)
        {
            DataSet rtn = new DataSet();
