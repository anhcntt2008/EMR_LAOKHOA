    public class MECommandPermissionsController : BaseBusinessController
    {
        public MECommandPermissionsController()
        {
            dal = new DALBaseProvider("MECommandPermissions", typeof(MECommandPermissionsInfo));
        }

        /// <summary>
        /// Get all command permissions by usergroupID
        /// </summary>
        /// <param name="userGroupID">User group ID</param>
        ///<returns>List of command permissions</returns>
        public List<MECommandPermissionsInfo> GetAllCommandPermissionsByUserGroup(int userGroupID)
        {
            DataSet ds = dal.GetDataSet("MECommandPermissions_GetAllCommandPermissionsByUserGroup", userGroupID);
            List<MECommandPermissionsInfo> result = new List<MECommandPermissionsInfo>();
            if (ds.Tables.Count > 0)
            {
                foreach (DataRow row in ds.Tables[0].Rows)
                {
                    MECommandPermissionsInfo objCommandPermissionsInfo = (MECommandPermissionsInfo)GetObjectFromDataRow(row);
                    result.Add(objCommandPermissionsInfo);
                }
            }
            return result;
        }

        /// <summary>
        /// Get all command permissions by usergroupID and command ID
        /// </summary>
        /// <param name="userGroupID">Usergroup ID</param>
        /// <param name="commandID">Command ID</param>
        /// <returns>List of command permissions</returns>
        public MECommandPermissionsInfo GetAllCommandPermissionsByUserGroupAndCommandID(int userGroupID, int commandID)
        {
            DataSet ds = dal.GetDataSet("MECommandPermissions_GetAllCommandPermissionsByUserGroupAndCommandID", userGroupID, commandID);
            if (ds.Tables[0].Rows.Count > 0 && ds.Tables.Count > 0)
            {
                MECommandPermissionsInfo objCommandPermissionsInfo = (MECommandPermissionsInfo)GetObjectFromDataRow(ds.Tables[0].Rows[0]);
                return objCommandPermissionsInfo;
            }
            return null;
        }

        
    }
