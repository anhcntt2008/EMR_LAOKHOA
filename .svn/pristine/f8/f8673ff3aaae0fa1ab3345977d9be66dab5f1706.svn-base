        public List<MEParamsInfo> GetAllByTemplateAndLookupDataParams(int templateId, int paramLookupId)
        {
            return GetListBusinessObjects<MEParamsInfo>(GetDataSet($"SELECT * FROM MEParams WHERE AAStatus='Alive' AND FK_METemplateID = {templateId} AND FK_MEParamLookupID = {paramLookupId}"));
        }
        public bool CheckParamUsed(int paramID)
        {
            String query = String.Format("select count(1) from METemplateParams where AAStatus = 'alive' and FK_MEParamID = {0}", paramID);
            int iCount = 0;
            System.Data.Common.DbCommand cmd = SqlDatabaseHelper.GetQuery(query);
            DataSet ds = SqlDatabaseHelper.RunQuery(cmd);
            if (ds.Tables.Count > 0)
            {
                if (ds.Tables[0].Rows.Count > 0)
                {
                    iCount = Convert.ToInt32(ds.Tables[0].Rows[0][0]);
                }
            }
            return iCount > 0;
        }

