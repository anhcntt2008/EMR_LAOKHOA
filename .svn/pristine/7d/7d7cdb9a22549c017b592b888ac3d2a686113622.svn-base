    public class ICTransferProposalsController : BaseBusinessController
    {
        public ICTransferProposalsController()
        {
            dal = new DALBaseProvider("ICTransferProposals", typeof(ICTransferProposalsInfo));
        }

        public List<ICTransferProposalsInfo> GetAllApprovedProposals()
        {
            DataSet ds = dal.GetDataSet("ICTransferProposals_GetAllApprovedProposals");
            ICTransferProposalsController objProposalItemsController = new ICTransferProposalsController();
            List<ICTransferProposalsInfo> proposalItemList = new List<ICTransferProposalsInfo>();
            if (ds.Tables[0].Rows.Count > 0)
            {
                foreach (DataRow dr in ds.Tables[0].Rows)
                {
                    ICTransferProposalsInfo objProposalItemsInfo = (ICTransferProposalsInfo)objProposalItemsController.GetObjectFromDataRow(dr);
                    proposalItemList.Add(objProposalItemsInfo);
                }
            }
            return proposalItemList;
        }

        public DataSet GetTransferProposal(int branchID, string transferNo, DateTime? fromDate, DateTime? toDate)
        {
            return dal.GetDataSet("ICTransferProposals_GetTransferProposals", branchID, transferNo, fromDate, toDate);
        }
    }
    #endregion
}