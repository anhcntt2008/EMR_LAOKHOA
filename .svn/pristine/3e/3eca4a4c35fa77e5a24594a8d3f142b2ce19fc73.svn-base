CREATE OR ALTER PROCEDURE [dbo].[METemplates_UpdateRelationTableOnDelete]
	@METemplateID int,
	@UpdatedUser nvarchar(50)
AS
BEGIN
SET NOCOUNT ON
UPDATE [dbo].[MEEmrTemplateActions]
SET [AAStatus]='Delete', AAUpdatedUser = @UpdatedUser, AAUpdatedDate=GETDATE()
WHERE [AAStatus]='Alive' AND [FK_METemplateID]=@METemplateID
END
